module Cubical.Analysis.Complex.FundamentalTheorem.Formulations.PointFree where

-- A proposed point-free formulation, NOT a theorem quoted from
-- Coquand--Spitters. Their representation theorems motivate this direction.
-- We specify a formal ball presentation explicitly, so "a root locale"
-- cannot mean an arbitrary unnamed space. No locale inhabitant is assumed.

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ; suc)
open import Cubical.Data.FinData using (Fin)
open import Cubical.Data.Vec using (Vec; lookup)
open import Cubical.Data.Sigma
open import Cubical.Data.Empty using (⊥)
open import Cubical.Data.Unit using (Unit)
open import Cubical.HITs.PropositionalTruncation using (∥_∥₁)
open import Cubical.Algebra.OrderedCommRing.Instances.Rationals
open PositiveRationals using (ℚ₊)
open import Cubical.Analysis.Real.Base using (rat)
open import Cubical.Analysis.Real.Algebra.Addition using (_+_)
open import Cubical.Analysis.Real.Order.Base using (_≤ℝ_)
open import Cubical.Analysis.Real.Order.Strict.Base using (_<ℝ_)
open import Cubical.Analysis.Complex.Base
open import Cubical.Analysis.Complex.Algebra
open import Cubical.Analysis.Complex.Modulus.Base using (modulusℂ)
open import Cubical.Analysis.Complex.Polynomial.Monic
open import Cubical.Analysis.Complex.FundamentalTheorem.Formulations.Presented
import Cubical.Analysis.Complex.FundamentalTheorem.Formulations.PointFreeCover as CoverDefinition

data RootBasicOpen : Type₀ where
  whole : RootBasicOpen
  ball : GaussianRational → ℚ₊ → RootBasicOpen

InBasicOpen : ℂ → RootBasicOpen → Type₀
InBasicOpen z whole = Unit
InBasicOpen z (ball c r) = modulusℂ (z -ℂ gaussianℂ c) <ℝ rat (fst r)

RefinesBasicOpen : RootBasicOpen → RootBasicOpen → Type₀
RefinesBasicOpen a whole = Unit
RefinesBasicOpen whole (ball c r) = ⊥
RefinesBasicOpen (ball c r) (ball d s) =
  modulusℂ (gaussianℂ c -ℂ gaussianℂ d) + rat (fst r) ≤ℝ rat (fst s)

StrictlyInsideBasicOpen : RootBasicOpen → RootBasicOpen → Type₀
StrictlyInsideBasicOpen whole a = ⊥
StrictlyInsideBasicOpen (ball c r) whole = Unit
StrictlyInsideBasicOpen (ball c r) (ball d s) =
  modulusℂ (gaussianℂ c -ℂ gaussianℂ d) + rat (fst r) <ℝ rat (fst s)

UniformlyRootFree : ∀ {n} → MonicPolynomial n → RootBasicOpen → Type₀
UniformlyRootFree p a = ∥ Σ[ gap ∈ ℚ₊ ] ((z : ℂ) → InBasicOpen z a →
  rat (fst gap) ≤ℝ modulusℂ (evaluateMonic p z)) ∥₁

-- The least proposition-valued cover generated by metric ball covers,
-- localization, transitivity, and deletion of uniformly root-free opens.
-- These constructors DEFINE the presentation; they are not postulated FTA
-- conclusions. Quantification over families of opens puts covers in Type₁.
PolynomialRootCover : ∀ {n} → MonicPolynomial n →
  RootBasicOpen → (RootBasicOpen → Type₀) → Type₁
PolynomialRootCover p = CoverDefinition.GeneratedCover.Cover RootBasicOpen ℚ₊ whole
  RefinesBasicOpen StrictlyInsideBasicOpen
  (λ ε b → ∥ Σ[ c ∈ GaussianRational ] b ≡ ball c ε ∥₁) (UniformlyRootFree p)

RootLocaleNontrivial : ∀ {n} → MonicPolynomial n → Type₁
RootLocaleNontrivial p = PolynomialRootCover p whole (λ _ → ⊥) → ⊥

RootLocaleCompact : ∀ {n} → MonicPolynomial n → Type₁
RootLocaleCompact p = (U : RootBasicOpen → Type₀) → PolynomialRootCover p whole U →
  ∥ Σ[ k ∈ ℕ ] Σ[ opens ∈ Vec RootBasicOpen k ]
    (((i : Fin k) → U (lookup i opens)) ×
      PolynomialRootCover p whole (λ b → ∥ Σ[ i ∈ Fin k ] b ≡ lookup i opens ∥₁)) ∥₁

-- Soundness supplies native roots as points of this presentation. It does
-- NOT identify all formal points with native sequential reals; that reverse
-- representation theorem would need an additional foundational argument.
NativeRootPointSoundness : Type₁
NativeRootPointSoundness = (n : ℕ) (p : MonicPolynomial n) (z : ℂ) →
  evaluateMonic p z ≡ 0ℂ → (a : RootBasicOpen) (U : RootBasicOpen → Type₀) →
  InBasicOpen z a → PolynomialRootCover p a U →
  ∥ Σ[ b ∈ RootBasicOpen ] (U b × InBasicOpen z b) ∥₁

PointFreeFundamentalTheorem : Type₁
PointFreeFundamentalTheorem = (n : ℕ) (p : MonicPolynomial (suc n)) →
  RootLocaleNontrivial p × RootLocaleCompact p
